# Normalise line endings.
* text=auto

# Exclude development-only paths from the Composer dist archive. This keeps the
# published package small and, importantly, keeps the docs site's Next.js build
# output (e.g. `docs/app/docs/[[...slug]]/`) out of the tarball — those `[[...]]`
# path segments break archive scanners that reject `..` path components.
/.github          export-ignore
/.idea            export-ignore
/.claude          export-ignore
/art              export-ignore
/docs             export-ignore
/plans            export-ignore
/tests            export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/pint.json        export-ignore
/testbench.yaml   export-ignore
/release.sh       export-ignore
